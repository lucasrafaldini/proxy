# Load into your shell with:  source .env   (settings read environment variables only)
export BASE_TARGET_URL=https://placeholderurl.com/
export SECRET_KEY=some-aleatory-secret
export LOGLEVEL=DEBUG
# Debug mode is off unless explicitly enabled (true/false; anything else stops
# startup). Never enable it in production. Locally you can also use
# `python manage.py runserver --debug` (make run-debug).
export DEBUG=false
# Host header values always accepted (comma-separated; '.example.com' also
# allows subdomains; '*' and ports are refused). More hosts can be added at
# runtime through /settings/allowed-hosts/. Default: localhost,127.0.0.1,[::1]
export ALLOWED_HOSTS=localhost,127.0.0.1
export POSTGRES_USER=db-user
export POSTGRES_PASSWORD=db-pass
export POSTGRES_DB=db-name
export POSTGRES_HOST=host-name

# Reverse proxies / load balancers allowed to set X-Forwarded-For (IPs or CIDRs,
# comma-separated). Leave empty when clients connect directly: the header is
# then ignored, because any client can forge it.
export TRUSTED_PROXIES=

# Optional rules read at startup (runtime rules live in the database/dashboard).
export BLACKLISTED_IPS=
export BLACKLISTED_PATHS=
