# Copy to .env and edit it. make targets (make migrate, make run, make doctor...) load it
# automatically; for direct commands load it yourself: source .env
# Settings are read from environment variables only (see README.md, Quick Run).

# Target to proxy (with the trailing slash).
export BASE_TARGET_URL=http://www.example.com/
# Reuse connections to the target (keep-alive pool). false = a new connection per call.
export UPSTREAM_KEEPALIVE=true
# The "django-insecure-" prefix makes make doctor and check --deploy flag it until you change it.
export SECRET_KEY=django-insecure-change-me-to-a-long-random-string
# DEBUG, INFO, WARNING, ERROR or CRITICAL (INFO adds one access line per request).
export LOGLEVEL=WARNING
# text (people) or json (one object per line, for log pipelines).
export LOG_FORMAT=text
# Requests slower than this (ms) are logged at WARNING.
export LOG_SLOW_REQUEST_MS=2000
# Never true in production (for local development use: make run-debug).
export DEBUG=false

export POSTGRES_USER=middleman
export POSTGRES_PASSWORD=change-me
export POSTGRES_DB=middleman
export POSTGRES_HOST=localhost
export POSTGRES_PORT=5432
# Seconds before giving up on an unreachable database (instead of hanging).
export POSTGRES_CONNECT_TIMEOUT=10

# Accepted Host header values (comma-separated); more can be added at runtime.
export ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Reverse proxies / load balancers allowed to set X-Forwarded-For (IPs or CIDRs).
export TRUSTED_PROXIES=

# Optional startup blacklist rules (rules managed on the dashboard need no restart).
# Comma-separated:
export BLACKLISTED_IPS=
export BLACKLISTED_PATHS=
# JSON arrays (User-Agents contain commas). Substrings, case-insensitive:
export BLACKLISTED_USER_AGENTS='[]'
# RE2 regexes searched in the User-Agent (escape backslashes for JSON: "bot/\\d+"):
export BLACKLISTED_USER_AGENTS_RE='[]'
# Example: export BLACKLISTED_USER_AGENTS='["sqlmap", "python-requests/"]'
#          export BLACKLISTED_USER_AGENTS_RE='["^$", "nikto|masscan"]'
